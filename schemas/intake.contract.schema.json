{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntakeContract",
  "type": "object",
  "required": ["ok", "trace_id", "lead_id", "normalized", "events"],
  "properties": {
    "ok": { "type": "boolean" },
    "trace_id": { "type": "string", "minLength": 36 },
    "lead_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "normalized": {
      "type": "object",
      "required": ["email", "full_name", "company"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "full_name": { "type": "string" },
        "company": { "type": "string" }
      }
    },
    "events": { "type": "array", "items": { "type": "string" } }
  }
}