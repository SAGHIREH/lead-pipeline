      "parameters": {
        "jsCode": "\nconst hunterData = $input.first().json.data;\nconst companyModel = {\n  name: hunterData.organization || \"Unknown\",\n  domain: hunterData.domain || $json.normalized.email_domain,\n  industry: hunterData.industry || \"Unknown\",\n  employee_count: hunterData.metrics ? hunterData.metrics.employees : 0,\n  enrichment_status: \"live\"\n};\nreturn [{ json: companyModel }];"
