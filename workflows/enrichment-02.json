    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst email = data.normalized.email;\nconst maskedEmail = email.replace(/(?<=.).(?=.*@)/g, '*');\n\nreturn [{\n  json: {\n    ...data,\n    normalized: {\n      ...data.normalized,\n      email_masked: maskedEmail\n    },\n    events: [\"LeadEnriched\"] \n  }\n}];"
