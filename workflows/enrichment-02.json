      "parameters": {
        "jsCode": "const originalData = $input.first().json;\nreturn [{\n  json: {\n    ...originalData, \n    company: {\n      name: \"Mock Company\",\n      domain: \"mock.com\",\n      industry: \"Mock Industry\",\n      employee_count: 0,\n      enrichment_status: \"mock_fallback\"\n    }\n  }\n}];"
